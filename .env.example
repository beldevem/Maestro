# Copy to .env (git-ignored) and fill in. docker compose reads it.

# Your user and group ids, so files Maestro writes in your repositories are yours (id -u, id -g).
MAESTRO_UID=1000
MAESTRO_GID=1000

# Where Maestro keeps its database, clones and worktrees. Mounted at the same path as on the host,
# so git worktree paths stay valid for local-folder projects. Must exist (mkdir -p).
MAESTRO_DATA=/home/you/.maestro

# Folder with the local repositories you want Maestro to work on (mounted at the same path).
PROJECTS_DIR=/home/you/projects

# Claude: an API key is the simplest. Or leave it empty and mount your Claude Code login (docker-compose.yml).
ANTHROPIC_API_KEY=

# Optional tokens; you can also add them in Settings (stored in $MAESTRO_DATA/secrets.json, mode 600).
GITHUB_TOKEN=
GITLAB_TOKEN=
JIRA_API_TOKEN=
FIGMA_TOKEN=

# Coding CLIs to install in the Docker image (as npm packages) to use as AI providers, e.g.
# EXTRA_NPM_CLIS=@github/copilot @openai/codex @google/gemini-cli
# Sign them in inside the container (docker compose exec maestro copilot), or pass their tokens below.
EXTRA_NPM_CLIS=

# Who commits made by Maestro are from.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
